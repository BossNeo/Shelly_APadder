# TEMPLATE ONLY: review docs/INSTALL.bg.md; never blindly import.
# Assumes Chateau management LAN 192.168.89.0/24 on bridge,
# no overlap with 172.31.253.0/29,
# existing IPv4 filter rules and no sp-* interfaces/chains. Review FastTrack and IPv6.
# No Wi-Fi change, disk formatting or repartitioning.
/interface/bridge/add name=sp-containers comment="shelly-panel container"
/ip/address/add address=172.31.253.1/29 interface=sp-containers comment="shelly-panel container"
/interface/veth/add name=sp-veth address=172.31.253.2/29 gateway=172.31.253.1
/interface/bridge/port/add interface=sp-veth bridge=sp-containers

# Dedicated chains, before existing filter rules.
/ip/firewall/filter/add chain=sp-input action=accept in-interface=sp-containers src-address=172.31.253.2 dst-address=172.31.253.1 protocol=tcp dst-port=80
/ip/firewall/filter/add chain=sp-input action=drop in-interface=sp-containers
/ip/firewall/filter/add chain=sp-input action=return
/ip/firewall/filter/add chain=input action=jump jump-target=sp-input place-before=0 comment="shelly-panel input"
/ip/firewall/filter/add chain=sp-forward action=accept in-interface=bridge out-interface=sp-containers src-address=192.168.89.0/24 dst-address=172.31.253.2 protocol=tcp dst-port=8088
/ip/firewall/filter/add chain=sp-forward action=accept in-interface=sp-containers out-interface=bridge src-address=172.31.253.2 dst-address=192.168.89.0/24 connection-state=established,related
/ip/firewall/filter/add chain=sp-forward action=drop out-interface=sp-containers
/ip/firewall/filter/add chain=sp-forward action=drop in-interface=sp-containers
/ip/firewall/filter/add chain=sp-forward action=return
/ip/firewall/filter/add chain=forward action=jump jump-target=sp-forward place-before=0 comment="shelly-panel forward"

# Panel on separate port; preserve WebFig, no WAN exposure or internet NAT.
/ip/firewall/nat/add chain=dstnat in-interface=bridge src-address=192.168.89.0/24 dst-address=192.168.89.1 protocol=tcp dst-port=8088 action=dst-nat to-addresses=172.31.253.2 to-ports=8088 comment="shelly-panel local UI"

# No IPv6 for the container. Add then move also works with an empty IPv6 firewall.
/ipv6/firewall/filter/add chain=input in-interface=sp-containers action=drop comment="shelly-panel IPv6 input"
/ipv6/firewall/filter/move [find where comment="shelly-panel IPv6 input"] destination=0
/ipv6/firewall/filter/add chain=forward in-interface=sp-containers action=drop comment="shelly-panel IPv6 outgoing"
/ipv6/firewall/filter/move [find where comment="shelly-panel IPv6 outgoing"] destination=0
/ipv6/firewall/filter/add chain=forward out-interface=sp-containers action=drop comment="shelly-panel IPv6 incoming"
/ipv6/firewall/filter/move [find where comment="shelly-panel IPv6 incoming"] destination=0
